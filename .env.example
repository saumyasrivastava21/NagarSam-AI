# ==============================================================================
# NagarSam AI — Environment Variables Configuration
# ==============================================================================

# Backend AI Inference Configuration
MODEL_PATH=./models/nagrik OS initial.pt
# MODEL_S3_URI=s3://your-org-nagarsam-models/yolo11m/nagrik-os-initial.pt
MODEL_VERSION=RDD2022-YOLO11m-v1
MODEL_DEVICE=auto
MODEL_IMAGE_SIZE=640
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_IOU_THRESHOLD=0.45
MAX_IMAGE_SIZE_MB=10
INFERENCE_TIMEOUT_SECONDS=60
MAX_CONCURRENT_INFERENCES=4

HOST=0.0.0.0
PORT=8000

# Frontend Configuration
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:8000/api/v1
