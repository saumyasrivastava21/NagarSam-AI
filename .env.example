# ==============================================================================
# NagarSam AI — Environment Variables Configuration (Phases 3, 4, 5)
# ==============================================================================

# Database & PostGIS Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nagarsam_db
# For SQLite local fallback:
# DATABASE_URL=sqlite:///./backend/data/nagarsam.db
USE_POSTGIS=false

# Redis & Celery / Job Queue Configuration
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage Configuration
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./backend/storage/uploads
AWS_REGION=us-east-1
S3_BUCKET_NAME=nagarsam-ai-storage

# AI Inference Service Configuration
POTHOLE_MODEL_PATH=./models/pothole_best.pt
POTHOLE_MODEL_VERSION=pothole-v1
POTHOLE_CONFIDENCE_THRESHOLD=0.40

GENERAL_MODEL_PATH=./models/nagrik OS initial.pt
GENERAL_MODEL_VERSION=road-defect-v1
GENERAL_CONFIDENCE_THRESHOLD=0.20

MODEL_DEVICE=cpu
MODEL_IMAGE_SIZE=640
MODEL_IOU_THRESHOLD=0.45
MAX_IMAGE_SIZE_MB=10
INFERENCE_TIMEOUT_SECONDS=60
MAX_CONCURRENT_INFERENCES=4

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Geospatial & Priority Engine Configuration
DUPLICATE_DISTANCE_METERS=50.0
DUPLICATE_TIME_WINDOW_HOURS=72.0

# Frontend Configuration
VITE_API_MODE=production
VITE_API_BASE_URL=http://localhost:8000/api/v1
